<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.0/css/all.min.css" integrity="sha512-9xKTRVabjVeZmc+GUW8GgSmcREDunMM+Dt/GrzchfN8tkwHizc5RP4Ok/MXFFy5rIjJjzhndFScTceq5e6GvVQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <title>Invitation de teste</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('templates/bonheur/css/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('templates/bonheur/css/styles.css') }}">
    <link rel="stylesheet" href="{{ asset('templates/bonheur/css/responsive.css') }}">
</head>
<body class="text-center">
<div id="invitation-card" class="cover-container d-flex h-100 p-3 mx-auto flex-column">
    <img src="{{ asset('templates/bonheur/images/top.png') }}" class="design-top" alt="top">
    <img src="{{ asset('templates/bonheur/images/bottom.png') }}" class="design-bottom" alt="bottom">
    <div class="container-bordered">
        <div class="container-bordered">
            <div id="img-section" class="" style="display: flex; align-items: center; justify-content: center">
                <img src="{{ asset(imagePath) }}" style="margin: 5px auto auto;border-radius: 50%; width: 200px" alt="photo">
{#                <img src="{{ asset('templates/bonheur/images/photoshape2.png') }}" alt="shape">#}
            </div>
            <p class="category">{{ category.name }}</p>
            <p class="name">{{ title }}</p>
            <p class="message">{{ details }}</p>
            <p class="message date">{{ startDate|date('d-m-Y-H-i-s') }}<br>{{ placeName }}<br>{{ address }}</p>
            <div class="action">
                <div class="icon mb-2"><i class="fa-solid fa-arrow-down fa-2xl"></i></div>
                <small>CLIQUEZ ICI</small>
            </div>
        </div>
    </div>
</div>

<div id="interactions" class="cover-container">
    <div class="top px-4">
        <p>OLIVIA ET BENJAMIN</p>
    </div>
    <div class="body p-4">
        <div class="invite">
            <p>Mr. <b>Daniel MWEMA</b></p>
        </div>
        <div class="code-container">
            <img src="{{ asset('templates/bonheur/images/code.png') }}" alt="12345">
        </div>
    </div>
    <div class="bottom">
        <button class="done" data-bs-toggle="modal" data-bs-target="#bookModal2"><span><i class="fa-solid fa-book"></i> Laisser un message au livre d'or</span><span class="badge"><i class="fa-solid fa-circle-check fa-2xl"></i></span></button>
        <button class="done" data-bs-toggle="modal" data-bs-target="#beverageModal"><span><i class="fa-solid fa-wine-glass"></i> Choisir une boisson</span><span class="badge"><i class="fa-solid fa-circle-check fa-2xl"></i></span></button>
        <button data-bs-toggle="modal" data-bs-target="#giftModal"><span><i class="fa-solid fa-gift"></i> Choisir un cadeau</span></button>
        <button><span><i class="fa-solid fa-map-location-dot"></i> Voir l'adresse sur Maps</span></button>
    </div>
    <div class="footer">
        <p>Creez des invitations electroniques pour vos evenements avec <a class="kw" href="https://kuuwaa.com" target="_blank">KuuWaa</a></p>
    </div>
</div>

<div class="modal fade" id="bookModal" tabindex="-1" aria-labelledby="bookModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookModalLabel">Livre d'or</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <textarea rows="5" class="form-control bookarea" placeholder="Un souhait, un message, un remerciement qui pourra leur faire plaisir..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary">Valider</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bookModal2" tabindex="-1" aria-labelledby="bookModalLabel2" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookModalLabel2">Livre d'or</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <span>"Soyez heureux et benis toute votre vie. Faites des enfant et fondez une famille solide et stable."</span>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="beverageModal" tabindex="-1" aria-labelledby="beverageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="beverageModalLabel">Boisson</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Veuillez Choisir les boissons que vous pourez prendre</p>
                <div class="beverages">
                    <button class="selected">Eau<span class="badge"><i class="fa-solid fa-circle-check fa-2xl"></i></span></button>
                    <button>Coca Cola</button>
                    <button>Fanta</button>
                    <button class="selected">Castel<span class="badge"><i class="fa-solid fa-circle-check fa-2xl"></i></span></button>
                    <button class="selected">Primus<span class="badge"><i class="fa-solid fa-circle-check fa-2xl"></i></span></button>
                    <button>Nkoy black</button>
                    <button>Champagne</button>
                    <button>Vin</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="giftModal" tabindex="-1" aria-labelledby="giftModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="giftModalLabel">Cadeaux souhaites</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Cadeaux pas encore pris</p>
                <div class="gifts">
                    <button class="selected">Voiture<span class="badge"><i class="fa-solid fa-circle-check fa-2xl"></i></span></button>
                    <button>Parcelle</button>
                    <button>Salle a manger</button>
                </div>
                <hr>
                <p>Cadeau deja pris</p>
                <div class="gifts">
                    <button><span>Iphone 16</span><span class="count">(10)</span></button>
                    <button><span>Verres</span><span class="count">(1)</span></button>
                    <button><span>TV</span><span class="count">(3)</span></button>
                    <button><span>Ordinateur</span><span class="count">(4)</span></button>
                    <button><span>Congelateur</span><span class="count">(12)</span></button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
<script>
    document.querySelector('.action').addEventListener('click', function() {
        const target = document.getElementById('interactions');
        target.scrollIntoView({ behavior: 'smooth' });
    });
</script>
</body>
</html>
