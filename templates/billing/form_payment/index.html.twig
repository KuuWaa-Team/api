<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page de Paiement</title>
    <!-- Ajoutez le lien vers le fichier CSS de Tailwind -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" rel="stylesheet" />
    <style>
        body {
            color: white;
        }
        .phone-input-group:focus-within {
            border: 1px solid #fff !important;
        }
        .phone-input-group input:focus {
            border: none !important;
        }
    </style>
</head>
<body class="bg-white" style="width: 100vw; height: 100vh; overflow-x: hidden; overflow-y: auto; background-color: #2F2644">
    <div class="container mx-auto" style="width: 100vw; padding: 40px 0; height: 100vh; display: flex; align-items: center; justify-content: center; flex-direction: column">
        <!-- Logo et produit -->
        <div class="flex justify-center items-center my-3 space-x-4">
            <img src="{{asset('web_side/assets/img/logo-2.png')}}" alt="Logo de votre entreprise" style="width: 70px;">
            <div style="width: 70px; height: 70px; background-image: url({{ event.imagePath }}); border-radius:50%; background-size: cover; background-position: center    "></div>
        </div>
        <div class="text-center my-3">
            <h1 class="text-xl font-semibold" style="margin-bottom: 0">{{ event.name }}</h1>
            <p class="text-gray-400 mt-2 text-sm" style="margin-top: 0">{{ event.category.name }}</p>
        </div>
        <div style="font-size: 11px; width: 90vw; margin: auto">
            <div style="width: 100%; border-bottom: 1px solid #fff; margin: 20px 0 5px 0"></div>
            <div style="display: flex; justify-content: space-between; width: calc(100% - 40px); margin:auto">
                <p style="margin: 0; opacity: .7">Pack</p>
                <p style="margin: 0; font-weight: bold">{{ event.eventPack.name }}</p>
            </div>
            <div style="width: 100%; border-bottom: 1px solid #fff; margin: 5px 0 5px 0"></div>
            <div style="display: flex; justify-content: space-between; width: calc(100% - 40px); margin:auto">
                <p style="margin: 0; opacity: .7">Nombre d'invitations</p>
                <p style="margin: 0; font-weight: bold">{{ event.eventPack.maxTickets }}</p>
            </div>
            <div style="width: 100%; border-bottom: 1px solid #fff; margin: 5px 0 5px 0"></div>
            <div style="display: flex; justify-content: space-between; width: calc(100% - 40px); margin:auto">
                <p style="margin: 0; opacity: .7">Cout du pack</p>
                <p style="margin: 0; font-weight: bold">{{ event.eventPack.price }}$</p>
            </div>
            <div style="width: 100%; border-bottom: 1px solid #fff; margin: 5px 0 5px 0"></div>
            {% for feature in event.features %}
                <div style="display: flex; justify-content: space-between; align-items: center; width: calc(100% - 40px); margin:auto">
                    <p style="margin: 0; opacity: .7; font-weight: bold">+ {{ feature.name }}</p>
                    <p style="margin: 0; font-weight: bold; color: forestgreen">{{ feature.price }}$</p>
                </div>
                <div style="width: 100%; border-bottom: 1px solid #fff; margin: 5px 0 5px 0"></div>
            {% endfor %}
            <div style="display: flex; justify-content: space-between; width: calc(100% - 40px); margin:auto">
                <p style="margin: 0; font-weight: bold; font-size: 1.3rem">Total a payer</p>
                <p style="margin: 0; font-weight: bold; font-size: 1.3rem; color: white">{{ amount }}$</p>
            </div>
            <div style="width: 100%; border-bottom: 1px solid #fff; margin: 5px 0 5px 0"></div>
        </div>
        <!-- Formulaire de paiement -->
        <div class="p-4 my-5 text-center">
            <h3 class="text-left font-bold mb-4">Comment souhaitez-vous faire le paiment ?</h3>
            <p class="text-left pb-5 text-sm" style="opacity: .7">Une fois le paiement effectue, votre evenement sera active et vous pourrez en suite partager vos invitations</p>
                <!-- Bouton pour le paiement mobile -->
                <button
                    data-modal-target="mobile-modal" data-modal-toggle="mobile-modal"
                    type="button"
                    class="
                    w-full
                    mb-3
                    p-3
                    border
                    hover:bg-gray-200
                    focus:outline-none
                    focus:ring-2" style="width: calc(100vw - 40px); background-color: white; color: black; font-weight: bold">
                    <div class="flex justify-between items-center" style="width: 100%;">
                        <p class="text-left font-semibold">Mobile Money </p>
                        <div class="text-right items-center flex space-x-1">
                            <img src="{{asset('web_side/assets/img/payment/orangemoney.png')}}" alt="OrangeMoney" style="width: 50px;"/>
                        <img src="{{asset('web_side/assets/img/payment/mpesa.png')}}" alt="Mpesa" style="width: 50px;"/>
                        <img src="{{asset('web_side/assets/img/payment/airtelmoney.png')}}"  alt="AirtelMoney" style="width: 50px;"/>
                        </div>
                    </div>
                 </button>
                 <br/>
                <button
                    type="button"
                    class="
                    w-full
                    mb-3
                    px-3
                    py-1
                    border
                    hover:bg-gray-200
                    focus:outline-none
                    focus:ring-2
                    focus:ring-gray-600" style="width: calc(100vw - 40px); background-color: white; color: black; font-weight: bold">
                    <div class="flex justify-between items-center">
                        <p class="text-left font-semibold">Carte de crédit </p>
                        <div class="text-right flex space-x-2">
                        <img src="{{asset('web_side/assets/img/payment/mastercard.png')}}"  alt="MasterCard" style="width: 40px;"/>
                        <img src="{{asset('web_side/assets/img/payment/visa.png')}}"  alt="Visa" style="width: 40px;"/>
                        </div>
                    </div>
                 </button>
        </div>
    </div>

    <!-- Main modal -->
    <div id="mobile-modal" data-modal-backdrop="static" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
        <div class="relative p-4 w-full max-w-2xl max-h-full">
            <!-- Modal content -->
            <div class="relative bg-white rounded-sm shadow dark:bg-gray-700" style="background-color: #2F2644; border: 2px solid #fff">
                <!-- Modal header -->
                <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
                    <h3 class="text-xl font-semibold dark:text-white">
                        Payer avec Mobile Money
                    </h3>
                    <button type="button" class="bg-transparent hover:bg-gray-200 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="mobile-modal">
                        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                        </svg>
                        <span class="sr-only">Close modal</span>
                    </button>
                </div>
                <!-- Modal body -->
                <div class="p-4 md:p-5 space-y-4">
                    <form class="max-w-sm mx-auto">
                        <label for="phone-input" class="block mb-2 text-sm font-medium dark:text-white">Entrez votre numéro de téléphone :</label>
                        <div class="relative phone-input-group mb-3 flex items-center space-x-1" style="border: 1px solid #fff">
                            <span style="display: inline-block; padding-left: 10px">+243</span>
                            <input type="text" style="background: none; border: none; color: white" id="phone-input" class="bg-gray-50 border border-gray-300 text-sm rounded-sm focus:ring-pink-500 focus:border-pink-500 block w-full py-3 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:border-pink-500" placeholder="8xxxxxxxx" required>
                        </div>
                        <!-- Modal footer -->
                        <div class="flex items-center py-1 md:p-5 rounded-b dark:border-gray-600">
                            <button id="btn-payer" data-modal-hide="mobile-modal" type="button" class="text-white bg-pink-700 hover:bg-pink-800 focus:ring-4 focus:outline-none focus:ring-pink-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-pink-600 dark:hover:bg-pink-700 dark:focus:ring-pink-800">Payer</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>

    <div id="modal-traitement" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; overflow: hidden; z-index: 60000; align-items: center; justify-content: center; background-color: rgba(0,0,0,.5)">
        <div style="padding: 20px; background-color: white; color: black; display: flex; align-items: center; justify-content: center">
            <img src="{{ asset('web_side/assets/img/loader.gif') }}" style="margin-right: 10px" width="25" />
            <p>En cours de traitement</p>
        </div>
    </div>

    <div id="modal-process" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; overflow: hidden; z-index: 60000; align-items: center; justify-content: center; background-color: rgba(0,0,0,.3)">
        <div style="padding: 20px; background-color: white; margin: 0 20px; text-align: center; color: black; display: flex; flex-direction: column; align-items: center; justify-content: center">
            <img src="{{ asset('web_side/assets/img/loader.gif') }}" style="margin-right: 10px" width="40" />
            <h4 style="font-weight: bold; font-size: 18px; margin: 10px 0;">Processus de paiement en cours</h4>
            <p style="font-size: 14px">Veuillez confirmer le paiement dans l'interface de votre operateur qui va s'afficher a votre ecran</p>
        </div>
    </div>

    <div id="modal-error" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; overflow: hidden; z-index: 60000; align-items: center; justify-content: center; background-color: rgba(0,0,0,.3)">
        <div style="padding: 20px; background-color: white; margin: 0 20px; text-align: center; color: black; display: flex; flex-direction: column; align-items: center; justify-content: center">
            <img src="{{ asset('web_side/assets/img/error.png') }}" style="margin-right: 10px" width="40" />
            <h4 style="font-weight: bold; font-size: 18px; margin: 10px 0; color: red">Une erreur est survenue</h4>
            <p style="font-size: 14px">Veuillez verifier les informations entrees et ressayez plutard</p>
            <button id="btn-close" data-modal-hide="mobile-modal" type="button" style="background-color: black" class="text-white mt-5 focus:ring-4 focus:outline-none focus:ring-pink-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-pink-600 dark:hover:bg-pink-700 dark:focus:ring-pink-800">D'accord</button>
        </div>
    </div>

    <div id="modal-success" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; overflow: hidden; z-index: 60000; align-items: center; justify-content: center; background-color: rgba(0,0,0,.3)">
        <div style="padding: 20px; background-color: white; margin: 0 20px; text-align: center; color: black; display: flex; flex-direction: column; align-items: center; justify-content: center">
            <img src="{{ asset('web_side/assets/img/success.png') }}" style="margin-right: 10px" width="40" />
            <h4 style="font-weight: bold; font-size: 18px; margin: 10px 0; color: green">Paiement effectué avec succès.</h4>
            <p style="font-size: 14px">Votre événement a été activé avec succès. Veuillez revenir en arrière et rafraîchir votre événement.</p>
            <button id="btn-close" data-modal-hide="mobile-modal" type="button" style="background-color: black" class="text-white mt-5 focus:ring-4 focus:outline-none focus:ring-pink-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-pink-600 dark:hover:bg-pink-700 dark:focus:ring-pink-800">D'accord</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        function checkPaymentStatus(orderNumber) {
            const errorModal = document.getElementById('modal-error');
            const processModal = document.getElementById('modal-process');
            const successModal = document.getElementById('modal-success');
            axios.get(`/api/events/{{ event.id }}/check-pay?on=${orderNumber}`)
                .then(function(response) {
                    console.log(response.data);
                    if (response.data['waiting']) {
                        setTimeout(function() {
                            checkPaymentStatus(orderNumber);
                        }, 1000);
                    } else {
                        processModal.style.display = 'none';
                        if (response.data['success']) {
                            successModal.style.display = 'flex';
                        } else {
                            errorModal.style.display = 'flex';
                        }
                    }
                })
                .catch(function(error) {
                    console.error(error);
                });
        }

        const btnPayer = document.getElementById('btn-payer');
        const btnClose = document.getElementById('btn-close');

        btnPayer.addEventListener('click', function() {
            const phoneNumber = document.getElementById('phone-input').value;
            const data = {
                phoneNumber: phoneNumber
            };

            const modal = document.getElementById('modal-traitement');
            const processModal = document.getElementById('modal-process');
            const errorModal = document.getElementById('modal-error');
            modal.style.display = 'flex';

            axios.post('https://kuuwaa.com/api/events/{{ event.id }}/pay-pack', data)
                .then(function(response) {
                    console.log(response.data);
                    modal.style.display = 'none';
                    if (response.data['success']) {
                        processModal.style.display = 'flex';
                        let orderNumber = response.data['orderNumber'];
                        checkPaymentStatus(orderNumber);
                    } else {
                        errorModal.style.display = 'flex';
                    }
                })
                .catch(function(error) {
                    modal.style.display = 'none';
                    console.error(error);
                    errorModal.style.display = 'flex';
                }
              );
            }
        );

        btnClose.addEventListener('click', function() {
            const errorModal = document.getElementById('modal-error');
            errorModal.style.display = 'none';
        });
    </script>
</body>
</html>
