<script>
    document.getElementById('downloadButton').addEventListener('click', function () {
        // Contenu HTML à convertir en image
        const content = document.getElementById('capture');
        content.style.display = 'block';

        // Utiliser html2canvas pour convertir le contenu en une image
        html2canvas(content, { useCORS: true }).then(function (canvas) { // Convertir le canvas en image au format PNG
            const image = canvas.toDataURL('image/png');

            // Créer un lien de téléchargement et déclencher le téléchargement
            const link = document.createElement('a');
            link.href = image;
            link.download = "Invitation {{ invitation.name }}.png";
            link.target = "_blank"; // Pour les navigateurs qui ne prennent pas en charge l'attribut download
            link.click();

            content.style.display = 'none';
        });
    });
</script>
