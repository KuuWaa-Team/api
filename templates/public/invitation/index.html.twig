<script>
    var color = "#ec7577";
    makeCode("qrcode", {'x': 200, 'y': 200});
    makeCode2("qrcode-capture", {'x': 200, 'y': 200});

    function makeCode(qrcodeId, size) {
        var valeur = "=&amp;915L";

        var qrcode = new QRCode(document.getElementById(qrcodeId), {
            width : size.x, // Spécification de la taille pour la hauteur du QRCODE
            height : size.y, // Spécification de la taille pour la largeur du QRCODE
            correctLevel : QRCode.CorrectLevel.H, // Spécification du niveau d'encodage (H: high, L: Low, M: medium)
            colorDark:"#000",
            colorLight:"#ffffff",
        }); // Initialisation de l'objet QRCODE

        qrcode.makeCode(valeur); // Méthode de l'objet QRCODE pour l'affichage
    }

    function makeCode2(qrcodeId, size) {
        var options = {
            text: "=&amp;915L",
            width: 200,
            height: 200,

            colorDark: "#000000",
            //colorLight: "#ffffff",
            tooltip: true,
            backgroundImage: "{{ asset('') }}/images/logo.png",
            backgroundImageAlpha: 0.2,
            autoColor: false,

            AO: color, // Position Outer - Top Right
            AI: color, // Position Outer - Bottom Right

            PO: color, // Couleur extérieure de la position globale. s'il n'est pas défini, la valeur par défaut est `colorDark`
            PI: color, // Couleur intérieure de la position globale. si non défini, la valeur par défaut est `colorDark`

            // === Timing Pattern Color
            timing: color,//'#e1622f',
            correctLevel: QRCode.CorrectLevel.H, //  L, M, Q, H
            dotScale: 0.7
        };

        // Créer un objet QRCode
        new QRCode(document.getElementById(qrcodeId), options);
    }


    document.getElementById('downloadButton').addEventListener('click', function () {
        // Contenu HTML à convertir en image
        console.log("ok")
        const content = document.getElementById('capture');
        content.style.display = 'block';

        // Utiliser html2canvas pour convertir le contenu en une image
        html2canvas(content).then(function (canvas) { // Convertir le canvas en image au format PNG
            const image = canvas.toDataURL('image/png');
            // console.log(image);

            // Créer un lien de téléchargement et déclencher le téléchargement
            const link = document.createElement('a');
            link.href = image;
            // link.download = "Couple kegbia.png";
            link.click();
            content.style.display = 'none';
        });
    });

    var countChecked = 0;

    $(window).on("load", function() {
        var wow = new WOW({
            boxClass: 'wow',
            animateClass: 'animated',
            offset: 0,
            mobile: true,
            live: true
        });
        wow.init();

        $inputs = $('.me-2').find('input');
        $inputs.each(function() {
            client_id = $(this).val();
            if ($(this).is(':checked')) {
                countChecked++;
            }
        });

        $reactions = $('.reaction').find('mark');
        $.ajax({
            type: 'GET',
            url: 'http://iparty-rdc.com/invite/ajax/reactionByEvent',
            data: {
                'event_id': '14',
            },
            success: function(response){
                console.log(response);
                if(response.is_ok){
                    var data = response.data;
                    $reactions.eq(0).text(data.like);
                    $reactions.eq(1).text(data.love);
                    $reactions.eq(2).text(data.amazing);
                    $reactions.eq(3).text(data.comment);
                }
            }
        });

    });



    $(".cbx-boisson").on('change',function (e) {
        var checked = $(this).is(':checked');
        if (checked) {
            if (countChecked >= 2) {
                $(this).prop('checked', false)
            } else {
                countChecked++;
            }
        } else {
            countChecked--;
        }


        console.log(countChecked);
    });
</script>

<!--main js file end-->
