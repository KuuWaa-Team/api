<script>
    let mediaRecorder;
    let audioChunks = [];
    let audioBlob;
    let audioUrl;
    let audio;
    let isPlaying = false;
    let isRecording = false;
    let timerInterval;

    const recordBtn = document.getElementById('recordBtn');
    const stopBtn = document.getElementById('stopBtn');
    const recordingInfo = document.getElementById('recordingInfo');
    const timerDisplay = document.getElementById('timer');
    const voiceMessage = document.getElementById('voice-message');
    const playButton = document.getElementById('play-button');
    const voiceDuration = document.getElementById('voice-duration');
    const progressFill = document.getElementById('progress-fill');
    const audioInput = document.getElementById('audioBlobBase64');
    const sendBookBtn = document.getElementById('sendBookBtn');
    const textMessage = document.getElementById('textMessage');
    const visibility = document.querySelector('input[name="visibility"]:checked')?.value;

    let startTime = 0;

    function formatTime(seconds) {
        if (!isFinite(seconds)) return "00:00";
        const m = Math.floor(seconds / 60).toString().padStart(2, '0');
        const s = Math.floor(seconds % 60).toString().padStart(2, '0');
        return `${m}:${s}`;
    }

    recordBtn.addEventListener('click', async () => {
        audioChunks = [];
        progressFill.style.width = '0%';
        voiceMessage.classList.add('hidden');

        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            mediaRecorder = new MediaRecorder(stream);
            mediaRecorder.start();
            isRecording = true;
            sendBookBtn.style.display = 'none';
            startTime = Date.now();
            updateTimer();

            recordingInfo.classList.remove('hidden');
            recordBtn.classList.add('hidden');
            stopBtn.classList.remove('hidden');

            mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
            mediaRecorder.onstop = () => {
                sendBookBtn.style.display = 'inline-flex';
                clearInterval(timerInterval);
                recordingInfo.classList.add('hidden');
                recordBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mic w-4 h-4 mr-2" __v0_r="0,38892,38906"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" x2="12" y1="19" y2="22"></line></svg> Réenregistrer`;
                recordBtn.classList.remove('hidden');
                stopBtn.classList.add('hidden');

                audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                audioUrl = URL.createObjectURL(audioBlob);
                audio = new Audio(audioUrl);
                blobToBase64(audioBlob);

                audio.onloadedmetadata = () => {
                    voiceDuration.textContent = `(${formatTime(audio.duration)})`;
                    voiceMessage.classList.remove('hidden');
                };
            };
        } catch (e) {
            sendBookBtn.style.display = 'inline-flex';
            alert("Erreur : " + e.message);
        }
    });

    stopBtn.addEventListener('click', () => {
        if (mediaRecorder && isRecording) {
            mediaRecorder.stop();
            isRecording = false;
        }
    });

    playButton.addEventListener('click', () => {
        if (!audio) return;

        if (!isPlaying) {
            isPlaying = true;
            playButton.innerHTML  = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause w-4 h-4" __v0_r="0,8602,8611"><rect x="14" y="4" width="4" height="16" rx="1"></rect><rect x="6" y="4" width="4" height="16" rx="1"></rect></svg>`;
            voiceDuration.textContent = `(00:00)`;
            progressFill.style.width = '0%';

            if (audio.readyState >= 1) {
                startPlayback();
            } else {
                audio.addEventListener('loadedmetadata', startPlayback, { once: true });
            }
        } else {
            audio.pause();
            isPlaying = false;
            playButton.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play w-4 h-4" __v0_r="0,8633,8642"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>`;
        }
    });

    function startPlayback() {
        audio.currentTime = 0;
        audio.play();

        updateProgressUI();
        audio.ontimeupdate = updateProgressUI;

        audio.ontimeupdate = () => {
            const current = audio.currentTime;
            const duration = audio.duration || 1; // éviter division par 0
            voiceDuration.textContent = `(${formatTime(current)})`;
            const progress = (current / duration) * 100;
            progressFill.style.width = `${progress}%`;
        };

        audio.onended = () => {
            isPlaying = false;
            playButton.innerHTML  = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play w-4 h-4" __v0_r="0,8633,8642"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>`;
            // progressFill.style.width = '0%';
        };
    }

    function updateProgressUI() {
        const current = audio.currentTime || 0;
        const duration = audio.duration || 1;
        voiceDuration.textContent = `(${formatTime(current)})`;
        const progress = (current / duration) * 100;
        progressFill.style.width = `${progress}%`;
    }

    function updateTimer() {
        timerInterval = setInterval(() => {
            const elapsed = (Date.now() - startTime) / 1000;
            timerDisplay.textContent = formatTime(elapsed);
        }, 500);
    }

    function blobToBase64(blob) {
        const reader = new FileReader();
        reader.readAsDataURL(blob);
        reader.onloadend = () => {
            audioInput.value = reader.result;
        };
    }

    sendBookBtn.addEventListener('click', async () => {
        const message = textMessage.value.trim();
        const hasAudio = !!audioBlob;

        if (!message && !hasAudio) {
            alert('Vous ne pouvez pas envoyer un message vide');
            return;
        }

        const formData = new FormData();
        formData.append('message', message);
        formData.append('hasAudio', hasAudio ? '1' : '0');
        formData.append('visibility', visibility);

        if (hasAudio) {
            const file = new File([audioBlob], 'audio.webm', { type: 'audio/webm' });
            formData.append('audio', file);
        }

        try {
            const response = await fetch('/api/invitations/{{ invitation.slug }}/send-book-messages', {
                method: 'POST',
                body: formData,
            });

            if (!response.ok) {
                throw new Error('Erreur lors de l’envoi');
            }

            window.location.reload();

        } catch (error) {
            console.error(error);
            alert('Erreur lors de l’envoi du message');
        }
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const playButton = document.getElementById('play-button');
        const audio = document.getElementById('audio-player');
        const progressFill = document.getElementById('progress-fill');
        const voiceDuration = document.getElementById('voice-duration');

        let isPlaying = false;

        if (!audio) return;

        // Affiche la durée une fois chargée
        audio.addEventListener('loadedmetadata', () => {
            const duration = formatTime(audio.duration);
            voiceDuration.textContent = `(${duration})`;
        });

        // Joue ou pause
        playButton.addEventListener('click', () => {
            if (isPlaying) {
                audio.pause();
            } else {
                audio.play();
            }
        });

        // Toggle texte et icône
        audio.addEventListener('play', () => {
            isPlaying = true;
            playButton.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-pause w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
        `;
        });

        audio.addEventListener('pause', () => {
            isPlaying = false;
            playButton.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-play w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polygon points="6 3 20 12 6 21 6 3"/></svg>
        `;
        });

        // Mise à jour de la barre de progression
        audio.addEventListener('timeupdate', () => {
            const progress = (audio.currentTime / audio.duration) * 100;
            progressFill.style.width = `${progress}%`;
        });

        audio.addEventListener('ended', () => {
            isPlaying = false;
            playButton.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-play w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polygon points="6 3 20 12 6 21 6 3"/></svg>
        `;
            progressFill.style.width = `0%`;
        });

        // Formatage de la durée (mm:ss)
        function formatTime(time) {
            const minutes = Math.floor(time / 60).toString().padStart(2, '0');
            const seconds = Math.floor(time % 60).toString().padStart(2, '0');
            return `${minutes}:${seconds}`;
        }
    });
</script>
