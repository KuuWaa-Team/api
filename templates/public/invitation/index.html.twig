
<!doctype html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors">
    <meta name="generator" content="Hugo 0.84.0">
    <title>Cover Template · Bootstrap v5.0</title>

    <link rel="canonical" href="https://getbootstrap.com/docs/5.0/examples/cover/">



    <!-- Bootstrap core CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <!-- Custom styles for this template -->
    <link href="cover.css" rel="stylesheet">

    <style>
        #confetti-canvas {
            position: fixed;
            z-index: 999;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
        }
    </style>
</head>
<body class="d-flex h-100 text-center text-white" style="background-color: #392F51;">

<div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
    <header class="mb-auto">
        <div>
        </div>
    </header>

    <main class="px-3">
        <div class="d-flex align-items-center justify-content-center">
            <div class="img-box" style="width: 250px; height: 250px; background-image: Url({{ asset(invitation.event.imagePath) }}); border-radius: 50%; background-size: cover; background-repeat: no-repeat; background-position: center;" ></div>
        </div>
        <h1 class="mt-4" style="color: #F24173;">{{ invitation.event.name }}</h1>
        <div style="width:600px; max-width:100%; margin:auto">
            <p class="lead mb-0"  style="font-size: 16px; font-weight: bold;">{{ (invitation.count == null or invitation.count > 1) ? 'Au' : 'À' }} {{ invitation.civility }} {{ invitation.name }}</p>
            <hr>
            <p class="mb-2" style="opacity: .5; font-size: 15px">Vous avez une invitation pour cet évenement.</p>
            <p><span style="opacity: .5">Pour accéder à votre invitation, veuillez télécharger l'application</span> <span style="color: #F24173">KuuWaa</span></p>
            <p class="lead d-flex justify-content-center mt-4">
                <button class="btn d-flex align-items-center justify-content-center" style="background-color: white; margin-right: 10px; text-align: left; display: inline-block; border-radius: 5px;">
                    <img src="{{ asset('images/google.png') }}" width="30" style="margin-right: 5px;">
                    <div>
                        <span style="font-size: 8px;display: block; margin-bottom: -3px;">Télécharger sur</span>
                        <span style="font-size: 12px; font-weight: bolder;">Google Play</span>
                    </div>
                </button>
                <button class="btn d-flex align-items-center justify-content-center" style="background-color: white; text-align: left; display: inline-block; border-radius: 5px;">
                    <img src="{{ asset('images/apple.png') }}" width="30" style="margin-right: 5px;">
                    <div>
                        <span style="font-size: 8px;display: block; margin-bottom: -3px;">Télécharger sur</span>
                        <span style="font-size: 12px; font-weight: bolder;">App Store</span>
                    </div>
                </button>
            </p>
        </div>
        <canvas id="confetti-canvas"></canvas>
    </main>

    <footer class="mt-auto text-white-50">
        <p>Généré par <a href="#" class="text-white" style="color: #F24173;"><span style="margin-right: 10px;">KuuWaa</span><img src="{{ asset('images/logo.png') }}" width="20"></p>
    </footer>
</div>


<!-- JS -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
<script type="text/javascript">
    const btn = document.querySelector('#btn');
    const canvas = document.querySelector('#confetti-canvas');
    function showConfetti(){
        var myConfetti = confetti.create(canvas, {
            resize: true,
            useWorker: true
        });
        myConfetti({
            particleCount: 100,
            spread: 160
        });
    }
    document.addEventListener("DOMContentLoaded", function(){
        showConfetti();
        setInterval(function () {
            showConfetti();
        }, 3000);
    });
</script>

</body>
</html>
