    $(".reaction").on('click',function (e) {
        e.preventDefault();

        if ($(this).data('type') == 'COMMENT') {
            $('#modal-preference').modal('show');
            return;
        }

        var $mark = $(this).find("mark");
        var value = parseInt($mark.text());
        var type = $(this).data('type');
        var invite_id = '758';

        console.log(type);
        $.ajax({
            type: 'POST',
            url: 'https://iparty-rdc.com/invite/ajax/reaction',
            data: {
                'invite_id': invite_id,
                'type': type,
            },
            success: function(response){
                console.log(response);
                if(response.is_ok){
                    if (response.message == "add") {
