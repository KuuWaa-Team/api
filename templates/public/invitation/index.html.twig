<script>
    document.addEventListener("DOMContentLoaded", () => {
        const deadline = new Date(document.getElementById("countdown").dataset.deadline);
        const messageElement = document.querySelector("#dynamic-countdown-message");
        let message = "";

        function updateCountdown() {
            const now = new Date();
            const diff = deadline - now;

            if (diff <= 0) {
                document.getElementById("days").textContent = "00";
                document.getElementById("hours").textContent = "00";
                document.getElementById("minutes").textContent = "00";
                document.getElementById("seconds").textContent = "00";
                messageElement.textContent = "C’est aujourd’hui, profitez pleinement !";
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const minutes = Math.floor((diff / (1000 * 60)) % 60);
            const seconds = Math.floor((diff / 1000) % 60);

            document.getElementById("days").textContent = String(days).padStart(2, "0");
            document.getElementById("hours").textContent = String(hours).padStart(2, "0");
            document.getElementById("minutes").textContent = String(minutes).padStart(2, "0");
            document.getElementById("seconds").textContent = String(seconds).padStart(2, "0");

            console.log("days");
            console.log(days);
            if (days > 30) {
                message = "Encore un peu de patience, le jour J se prépare !";
            } else if (days > 14) {
                message = "Le bonheur approche à grands pas !";
            } else if (days > 7) {
                message = "Plus que quelques jours avant l'événement !";
            } else if (days > 1) {
                message = "C’est bientôt, préparez-vous !";
            } else if (days === 1) {
                message = "Demain, c’est le grand jour !";
            } else if (days === 0) {
                message = "C’est aujourd’hui, profitez pleinement !";
            }

            messageElement.textContent = message;
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const buttons = document.querySelectorAll("[data-beverage-id]");
        const slug = "{{ invitation.slug }}";

        buttons.forEach(button => {
            button.addEventListener("click", () => {
                const beverageId = button.dataset.beverageId;

                const isCurrentlySelected = button.classList.contains("selected");
                const isSelected = !isCurrentlySelected;

                const action = isSelected ? 'add' : 'remove';

                fetch(`/api/invitations/${slug}/toggle-beverage`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': '{{ csrf_token("authenticate") }}'
                    },
                    body: new URLSearchParams({
                        beverageId: beverageId,
                        action: action
                    })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const small = button.querySelector('small');
                            if (data.countTaken === 0) {
                                small.textContent = "Aucune autre personne n’a choisi cette boisson";
                            } else {
                                small.textContent = `${data.countTakenText.charAt(0).toUpperCase() + data.countTakenText.slice(1)} ont choisi cette boisson`;
                            }
                        } else {
                            alert(data.message);
                        }
                    });

                // Mise à jour des styles
                if (isSelected) {
                    button.classList.add("selected");
                    button.classList.add("bg-[{{ template.primaryColor }}]");
                    button.style.setProperty('color', 'white', 'important');
                    button.querySelectorAll('svg').forEach(svg => {
                        svg.style.setProperty('color', 'white', 'important');
                    });
                } else {
                    button.classList.remove("selected");
                    button.classList.remove("bg-[{{ template.primaryColor }}]");
                    button.style.removeProperty('color');
                    button.querySelectorAll('svg').forEach(svg => {
                        svg.style.removeProperty('color');
                        svg.style.removeProperty('fill');
                    });
                }
            });
        });
    });
</script>
