{% extends 'base.html.twig' %}

{% block title %}KuuWaa - Home{% endblock %}

{% block body %}
<!-- Banner Area Start-->
    <section class="banner-area" style="background-image: url(web_side/assets/img/banner/1.png)">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-10 align-self-center">
                    <div class="banner-inner text-lg-start text-center">
                        <h6>Avec KuuWaa </h6>
                        <h1>Transformez vos évenements en expériences inoubliables</h1>
                        <p class="me-5">Invitations électroniques - Partage automatique d'invitations - Livre d'or électronique - Gestion de boissons - Et autres</p>
                        <div class="btn-area">
                            <a class="btn btn-white" href="https://play.google.com/store/apps/details?id=com.app.kuuwaa" target="_blank"><svg class="svg-inline--fa fa-google-play fa-w-16" aria-hidden="true" focusable="false" data-prefix="fab" data-icon="google-play" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" data-fa-i2svg=""><path fill="currentColor" d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"></path></svg><!-- <i class="fab fa-google-play"></i> Font Awesome fontawesome.com -->Google-play</a>
                            <a class="btn btn-border-white" href="https://apps.apple.com/ca/app/kuuwaa/id6476254390?l=fr-CA" target="_blank"><i class="fab fa-apple"></i>App-Store</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-8">
                    <div class="thumb text-end">
                        <img class="animated phone-bounce" src="{{asset('web_side/assets/img/banner/01.png')}}" alt="img">
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Banner Area End -->


    <!--service-area start-->
    <section class="service-area default-pd-top">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="section-title text-center">
                        <h4 class="sub-title">Nos Serices</h4>
                        <h2 class="title">Les meilleurs services offerts par KuuWaa</h2>
                    </div>                    
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-xl-4 col-md-6">
                    <div class="single-service-inner">
                        <div class="thumb">
                            <img src="{{asset("web_side/assets/img/service/1.jpg")}}" alt="img">
                        </div>
                        <h4><a href="service-details.html">Gestion électronique des événements</a></h4>
                        <p>L'application KuuWaa offre une solution complète de gestion électronique des événements. Que vous organisiez un mariage, un anniversaire, des conférences, des séminaires ou d'autres types d'événements, notre application vous permet de gérer facilement la gestion de vos invités et bien d'autres activités de l'évenement.</p>
                    </div>
                </div>
                <div class="col-xl-4 col-md-6">
                    <div class="single-service-inner">
                        <div class="thumb">
                            <img src="{{asset("web_side/assets/img/service/2.jpg")}}" alt="img">
                        </div>
                        <h4><a href="service-details.html">Billetterie électronique</a></h4>
                        <p>Notre service de billetterie électronique simplifie l'achat et la gestion des billets pour vos événements. Que ce soit pour des concerts, des festivals, des spectacles ou d'autres types d'événements, notre plateforme vous permet de vendre et de distribuer facilement des billets électroniques, offrant ainsi une expérience pratique et sans tracas pour vos participants.</p>
                    </div>
                </div>
                <div class="col-xl-4 col-md-6">
                    <div class="single-service-inner">
                        <div class="thumb">
                            <img src="{{asset("web_side/assets/img/service/3.jpg")}}" alt="img">
                        </div>
                        <h4><a href="service-details.html">Promotion des événements</a></h4>
                        <p>Notre service de promotion des événements vous aide à accroître la visibilité et la participation à vos événements. Grâce à des stratégies de marketing ciblées et à une diffusion efficace sur les médias sociaux, nous vous aidons à promouvoir vos événements auprès d'un large public. Que ce soit pour des conférences, des expositions, des festivals ou d'autres types d'événements, notre service de promotion vous permet d'atteindre votre public cible de manière efficace et percutante.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- service Area End -->

    <!--featured-area start-->
    <section class="featured-area pd-top-110">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-6 col-lg-8 col-md-10">
                    <div class="section-title text-center">
                        <h2 class="title">Utilisez votre téléphone android ou iOS et bénéficiez de la belle expérience</h2>
                    </div>                    
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-6 align-self-center">
                    <div class="featured-accordion" id="accordionExample">
                        <div class="accordion-item active">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                    <img src="{{asset('web_side/assets/img/featured/2i.png')}}" alt="img">Partages rapide des invitations
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    Avec KuuWaa, le partage de vos invitations devient un jeu d'enfant. Créez vos invitations personnalisées en quelques clics, et partagez-les rapidement avec vos convives par email, messagerie instantanée ou sur les réseaux sociaux.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingTwo">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                    <img src="{{asset('web_side/assets/img/featured/2i.png')}}" alt="img">Invitation et ticket avec QR Code
                                </button>
                            </h2>
                            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    À leur arrivée, vos invités pourront simplement présenter leur invitation numérique, dont le QR code sera scanné pour une vérification rapide et sécurisée. Fini les listes interminables et la queue à l'entrée ! Grâce à KuuWaa, l'accueil de vos invités se fait de manière fluide et efficace.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingThree">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                    <img src="{{asset('web_side/assets/img/featured/2i.png')}}" alt="img">Livre d'Or
                                </button>
                            </h2>
                            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    Conservez un souvenir précieux de votre événement avec notre livre d'or virtuel. Vos invités pourront y laisser des messages pour immortaliser les meilleurs moments de la soirée. Retrouvez ensuite ce livre d'or dans l'application, pour revivre ces instants magiques.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--featured-area end-->

    <!--pricing-area start-->
    <section class="pricing-area default-pd-top pd-bottom-120 text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="section-title text-center">
                        <h4 class="sub-title">Combien ça coûte ?</h4>
                        <h2 class="title">Econnomisez 90% de votre argent en choisissant KuuWaa à la place des invitations en papier</h2>
                    </div>                    
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div id="monthly" class="wrapper-full">
                        <div class="row justify-content-center">
                            {% set i = 0 %}
                            {% for pack in packs %}
                                <div class="col-lg-4 col-md-6">
                                    <div class="single-price">
                                        <div class="thumb">
                                            <img src="{{asset(i == 0 ? 'web_side/assets/img/pricing/1.png': (i == 1 ? 'web_side/assets/img/pricing/2.png' : 'web_side/assets/img/pricing/3.png'))}}" alt="img">
                                        </div>
                                        <h4 class="pricing-title">{{ pack.name }}</h4>
                                        <div class="price-details">
                                            <span>$</span>
                                            <span class="price">{{ pack.price }}</span>
                                        </div>
                                        <ul class="pricing-list" style="padding-bottom: 0">
                                            <li><b>{{ pack.maxTickets }}</b> Invitations</li>
                                        </ul>
                                    </div>
                                </div>
                                {% set i = i + 1 %}
                            {% endfor %}
                        </div>
                    </div>
                </div>  
            </div>
        </div>
    </section>
    <!--pricing-area end-->

    <!--app-Screen-area-->
    <section class="app-screen-area" style="background-image: url(web_side/assets/img/other/3.png); background-size: contain">
        <div class="bg-main-gradient"></div>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-4 col-lg-5 align-self-center" style="padding: 80px 0; text-align: center">
                    <div class="section-title mb-0 pb-4">
                        <h2 class="title text-white">Rejoignez-nous et vivez la belle expérience.</h2>
                        <p class="text-white">Téléchargez l'application KuuWaa</p>
                    </div>
                    <div class="btn-area">
                        <a class="btn btn-white" href="https://play.google.com/store/apps/details?id=com.app.kuuwaa" target="_blank"><svg class="svg-inline--fa fa-google-play fa-w-16" aria-hidden="true" focusable="false" data-prefix="fab" data-icon="google-play" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" data-fa-i2svg=""><path fill="currentColor" d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"></path></svg><!-- <i class="fab fa-google-play"></i> Font Awesome fontawesome.com -->Google-play</a>
                        <a class="btn btn-border-white" href="https://apps.apple.com/ca/app/kuuwaa/id6476254390?l=fr-CA" target="_blank"><i class="fab fa-apple"></i>App-Store</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--app-Screen-area end-->

{% endblock %}
