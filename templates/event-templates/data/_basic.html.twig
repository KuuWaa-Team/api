<style>
    @font-face {
        font-family: 'Fraunces';
        src: url('{{ asset('templates/basic/Fraunces/Fraunces-VariableFont_SOFT,WONK,opsz,wght.ttf') }}') format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    @font-face {
        font-family: 'TheSeasons';
        src: url('{{ asset('templates/basic/TheSeasons/Fontspring-DEMO-theseasons-reg.otf') }}') format('opentype');
        font-weight: normal;
        font-style: normal;
    }

    body {
        margin: 0;
        background-color: #fffdf6;
        font-family: 'Fraunces', serif;
        color: #384b7c;
    }

    .invitation-card {
        position: relative;
        background-color: #fffdf6;
        padding: 4rem 1rem 4.5rem;
        border: 1px solid {{ template.primaryColor }};
        max-width: 600px;
        margin: auto;
        text-align: center;
        font-family: 'Fraunces', serif;
        color: #a77b00;
        overflow: hidden;
        z-index: 2;
        border-radius: 5px;
        box-shadow:
                0 4px 6px rgba(0, 0, 0, 0.05),
                0 8px 20px rgba(0, 0, 0, 0.08);
    }

    .divider {
        width: 100%;
        max-width: 300px;
        height: 1px;
        background-color: #384b7c;
        margin: 1rem auto;
        position: relative;
    }

    .top-icon,
    .bottom-icon {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
    }

    .invitation-card {
        position: relative;
        background-color: #fffdf6;
        padding: 2rem 1rem; /* padding réduit */
        border: 1px solid {{ template.primaryColor }};
        max-width: 600px;
        margin: auto;
        text-align: center;
        font-family: 'FairDisplay', serif;
        color: {{ template.primaryColor }};
        overflow: hidden;
        z-index: 2;
        border-radius: 5px;
        box-shadow:
                0 4px 6px rgba(0, 0, 0, 0.05),
                0 8px 20px rgba(0, 0, 0, 0.08);
    }

    .divider-container {
        position: relative;
        width: 100%;
        max-width: 300px;
        height: 1px;
        background-color: {{ template.primaryColor }};
        margin: 2rem auto;
    }

    .icon-over-divider {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: #fffdf6;
        padding: 0 0.25rem;
        z-index: 2;
    }

    .bottom-icon {
        width: 45px;
    }

    .heading,
    .names,
    .ampersand,
    .event-date,
    .event-location,
    .rsvp,
    .reception {
        color: {{ template.primaryColor }};
    }

    .top-icon {
        top: 1rem;
        width: 40px;
    }

    .bottom-icon {
        bottom: 1.2rem;
        width: 60px;
    }

    .top-icon {
        width: 40px;
        margin-bottom: 1rem;
    }

    .heading {
        font-size: 0.75rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 2rem;
    }

    .names {
        font-family: 'TheSeasons', cursive;
        font-size: 2.5rem;
        margin: 0.5rem 0;
        line-height: 1;
    }

    .ampersand {
        font-family: 'Fraunces', serif;
        font-size: 2rem;
        margin: 0.5rem 0;
    }

    .event-date {
        margin-top: 2rem;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .event-location {
        margin-top: 1.5rem;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .rsvp {
        margin-top: 1.5rem;
        font-size: 0.9rem;
    }

    .reception {
        margin-top: 1.5rem;
        font-style: italic;
        font-size: 0.85rem;
    }

</style>

<div class="invitation-card">
    <!-- Top Divider with Icon -->
    <div class="divider-container">
        <img src="{{ asset('templates/basic/top.png') }}" alt="top icon" class="icon-over-divider" />
    </div>

    <!-- Texts -->
    <div class="heading">
        {{ invitation.event.category.name }}
    </div>

    <div class="names">{{ invitation.event.title }}</div>

    <div class="event-date">
        {{ date }}<br />
        A {{ hour }}H{{ minute }}
    </div>

    <!-- Divider (milieu) -->
    <div class="divider-container" style="margin-top: 2.5rem;"></div>

    <!-- Address & RSVP -->
    <div class="event-location">
        {{ invitation.event.address }}<br>
        {{ invitation.event.placeName }}
    </div>

    <div class="rsvp">Bienvenue à vous !</div>

    <!-- Bottom Divider with Icon -->
    <div class="divider-container" style="margin-top: 3rem;">
        <img src="{{ asset('templates/basic/bottom.png') }}" alt="bottom icon" class="icon-over-divider bottom-icon" />
    </div>
</div>


