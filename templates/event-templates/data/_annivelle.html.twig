<style>
    /* === POLICES === */
    @font-face {
        font-family: 'Maragsa';
        src: url('{{ asset('templates/annivelle/maragsa.otf') }}') format('opentype');
    }

    @font-face {
        font-family: 'Mistrully';
        src: url('{{ asset('templates/annivelle/Mistrully.ttf') }}') format('truetype');
    }

    body {
        margin: 0;
        padding: 0;
        background-color: #fff;
        color: {{ template.primaryColor }};
        font-family: 'Poppins', sans-serif;
        overflow-x: hidden;
    }

    .invitation-card {
        position: relative;
        max-width: 650px;
        margin: 0 auto;
        background-color: #fff;
        border-radius: 8px;
        overflow: hidden;
        text-align: center;
        padding: 2rem 1.5rem 5rem;
        box-sizing: border-box;
    }

    /* === BORDURES === */
    .border {
        position: absolute;
        width: 20px;
        height: 100%;
        background: url('{{ asset('templates/annivelle/border.png') }}') repeat-y;
        background-size: contain;
        top: 0;
    }
    .border.left { left: 0; }
    .border.right { right: 0; }

    /* === DÉCORS HAUT === */
    .top-decor {
        width: 100%;
        height: auto;
        display: block;
        margin: 0 auto 1rem;
        animation: dropIn 1.5s ease;
    }

    @keyframes dropIn {
        from { transform: translateY(-30px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .topleft, .topright {
        position: absolute;
        top: 0;
        width: 130px;
        z-index: 1;
        animation: float 6s ease-in-out infinite;
    }
    .topleft { left: -20px; animation-delay: 0s; }
    .topright { right: -20px; animation-delay: 3s; }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-12px); }
    }

    /* === CONFETTIS === */
    .confetti {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: auto;
        pointer-events: none;
        animation: confettiFall 10s linear infinite;
        opacity: 0.8;
    }

    @keyframes confettiFall {
        from { transform: translateY(-20px); }
        to { transform: translateY(20px); }
    }

    /* === TITRES === */
    .main-title {
        font-family: 'Maragsa', serif;
        font-size: 3rem;
        line-height: 1;
        margin-top: 1.5rem;
        margin-bottom: 0.3rem;
        color: {{ template.primaryColor }};
        animation: fadeIn 1.2s ease;
    }

    .subtitle {
        font-family: 'Poppins', sans-serif;
        font-weight: 400;
        font-size: 1.1rem;
        margin-bottom: 1.8rem;
    }

    .save-date {
        font-family: 'Mistrully', cursive;
        font-size: 2rem;
        margin-bottom: 0.8rem;
        animation: float 4s ease-in-out infinite;
    }

    /* === DATE & HEURE === */
    .date {
        font-size: 1.2rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }
    .time {
        font-size: 1rem;
        margin-bottom: 1.2rem;
    }

    /* === LIEU === */
    .venue {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 0.3rem;
        text-decoration: underline;
    }
    .address {
        font-size: 0.95rem;
        line-height: 1.4;
    }

    /* === SECTION DES FILLES === */
    .girls-section {
        position: relative;
        margin-top: 2.5rem;
    }

    .support {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        display: block;
    }

    .girls {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        width: 90%;
        max-width: 500px;
        animation: riseUp 1.8s ease;
    }

    @keyframes riseUp {
        from { transform: translate(-50%, 30px); opacity: 0; }
        to { transform: translate(-50%, 0); opacity: 1; }
    }

    /* === EFFETS === */
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

</style>

<div class="invitation-card">
    <!-- Bordures -->
    <div class="border left"></div>
    <div class="border right"></div>

    <!-- Décors haut -->
    <img src="{{ asset('templates/annivelle/top.png') }}" class="top-decor" alt="Top decor">
    <img src="{{ asset('templates/annivelle/topleft.png') }}" class="topleft" alt="Fleur gauche">
    <img src="{{ asset('templates/annivelle/topright.png') }}" class="topright" alt="Fleur droite">

    <!-- Confettis -->
    <img src="{{ asset('templates/annivelle/particulars.png') }}" class="confetti" alt="Confetti">

    <!-- Contenu principal -->
    <div class="main-title">Kitty Party</div>
    <div class="subtitle">Invitation</div>
    <div class="save-date">Save the date</div>

    <div class="date">10 | 01 | 2025</div>
    <div class="time">at 7:00 PM</div>

    <div class="venue">Venue</div>
    <div class="address">23 Anywhere St, Any City, ST 12345</div>

    <!-- Section des filles -->
    <div class="girls-section">
        <img src="{{ asset('templates/annivelle/support.png') }}" class="support" alt="Support">
        <img src="{{ asset('templates/annivelle/girls.png') }}" class="girls" alt="Girls">
    </div>
</div>
