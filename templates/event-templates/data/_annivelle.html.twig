<style>
    /* === POLICES === */
    @font-face {
        font-family: 'Maragsa';
        src: url('{{ asset('templates/annivelle/maragsa.otf') }}') format('opentype');
    }

    @font-face {
        font-family: 'Mistrully';
        src: url('{{ asset('templates/annivelle/Mistrully.ttf') }}') format('truetype');
    }

    .invitation-card {
        position: relative;
        background-color: #fff;
        color: {{ template.primaryColor }};
        font-family: 'Poppins', sans-serif;
        max-width: 650px;
        margin: auto;
        padding: 2.5rem 1.5rem 5rem;
        box-sizing: border-box;
        text-align: center;
        overflow: hidden;
        border-radius: 8px;
    }

    /* === BORDURES === */
    .border {
        position: absolute;
        background: url('{{ asset('templates/annivelle/border.png') }}') repeat;
        background-size: contain;
        z-index: 3;
    }

    .border.left,
    .border.right {
        top: 0;
        width: 16px;
        height: 100%;
    }
    .border.left { left: 0; }
    .border.right { right: 0; }

    .border.top,
    .border.bottom {
        left: 0;
        width: 100%;
        height: 16px;
        transform: rotate(90deg);
        transform-origin: center;
    }
    .border.top { top: 0; }
    .border.bottom { bottom: 0; }

    /* === DÉCORS === */
    .top-decor {
        width: 100%;
        margin: 0 auto 1rem;
        display: block;
        animation: dropIn 1.2s ease;
        position: relative;
        z-index: 2;
    }

    .topleft, .topright {
        position: absolute;
        top: 0;
        width: 130px;
        z-index: 2;
        animation: float 6s ease-in-out infinite;
    }

    .topleft { left: -15px; animation-delay: 0s; }
    .topright { right: -15px; animation-delay: 3s; }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    @keyframes dropIn {
        from { transform: translateY(-20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    /* === CONFETTIS === */
    .confetti {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: auto;
        pointer-events: none;
        opacity: 0.85;
        z-index: 1;
        animation: confettiFloat 10s linear infinite;
    }

    @keyframes confettiFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(10px); }
    }

    /* === TITRES === */
    .main-title {
        font-family: 'Maragsa', serif;
        font-size: 3rem;
        line-height: 1;
        margin-top: 1.5rem;
        margin-bottom: 0.3rem;
        color: {{ template.primaryColor }};
        animation: fadeIn 1.2s ease;
        z-index: 2;
        position: relative;
    }

    .subtitle {
        font-family: 'Poppins', sans-serif;
        font-weight: 400;
        font-size: 1.1rem;
        margin-bottom: 1.8rem;
        position: relative;
        z-index: 2;
    }

    .save-date {
        font-family: 'Mistrully', cursive;
        font-size: 2rem;
        margin-bottom: 1rem;
        animation: float 4s ease-in-out infinite;
        position: relative;
        z-index: 2;
    }

    /* === DATE ET HEURE === */
    .date {
        font-size: 1.2rem;
        font-weight: 500;
        margin-bottom: 0.3rem;
        position: relative;
        z-index: 2;
    }

    .time {
        font-size: 1rem;
        margin-bottom: 1.5rem;
        position: relative;
        z-index: 2;
    }

    /* === LIEU === */
    .venue {
        font-size: 1.2rem;
        font-weight: 700;
        text-decoration: underline;
        margin-bottom: 0.3rem;
        position: relative;
        z-index: 2;
    }

    .address {
        font-size: 0.95rem;
        line-height: 1.4;
        position: relative;
        z-index: 2;
    }

    /* === SECTION DES FILLES === */
    .girls-section {
        position: relative;
        margin-top: 2.8rem;
        z-index: 2;
    }

    .support {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        display: block;
        position: relative;
        z-index: 1;
    }

    .girls {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        width: 90%;
        max-width: 500px;
        animation: riseUp 1.6s ease;
        z-index: 2;
    }

    @keyframes riseUp {
        from { transform: translate(-50%, 25px); opacity: 0; }
        to { transform: translate(-50%, 0); opacity: 1; }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

</style>

<div class="invitation-card">
    <!-- Bordures -->
    <div class="border left"></div>
    <div class="border right"></div>
    <div class="border top"></div>
    <div class="border bottom"></div>

    <!-- Décors -->
    <img src="{{ asset('templates/annivelle/top.png') }}" class="top-decor" alt="Top decor">
    <img src="{{ asset('templates/annivelle/topleft.png') }}" class="topleft" alt="Fleur gauche">
    <img src="{{ asset('templates/annivelle/topright.png') }}" class="topright" alt="Fleur droite">
    <img src="{{ asset('templates/annivelle/particulars.png') }}" class="confetti" alt="Confettis">

    <!-- Contenu principal -->
    <div class="main-title">Kitty Party</div>
    <div class="subtitle">Invitation</div>
    <div class="save-date">Save the date</div>

    <div class="date">{{ date }}</div>
    <div class="time">{{ 'à'|upper }} {{ hour }}H{{ minute }}</div>

    <div class="venue">Venue</div>
    <div class="address">{{ invitation.event.address }}, {{ invitation.event.placeName }}</div>

    <!-- Section filles -->
    <div class="girls-section">
        <img src="{{ asset('templates/annivelle/support.png') }}" class="support" alt="Support">
        <img src="{{ asset('templates/annivelle/girls.png') }}" class="girls" alt="Girls">
    </div>
</div>
