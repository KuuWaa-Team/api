<style>
    @import url('https://fonts.googleapis.com/css2?family=Alex+Brush&family=Alice&display=swap');

    body {
        margin: 0;
        background-color: #fff;
        font-family: 'Alice', serif;
        color: {{ template.primaryColor }};
    }

    .invitation-card {
        position: relative;
        background-color: #fff;
        max-width: 600px;
        margin: auto;
        text-align: center;
        font-family: 'Alice', serif;
        color: {{ template.primaryColor }};
        overflow: hidden;
        z-index: 2;
        border-radius: 5px;
        box-shadow:
            0 4px 6px rgba(0, 0, 0, 0.05),
            0 8px 20px rgba(0, 0, 0, 0.08);
    }

    /* === IMAGE TOP === */
    .bg-top {
        height: 260px;
        background: url('{{ asset('templates/minimal/bgtop.png') }}') center/cover no-repeat;
        position: relative;
        background-size: cover;
    }

    /* === MASQUE BLANC === */
    .white-mask {
        position: absolute;
        top: 200px;
        left: 50%;
        transform: translateX(-50%);
        width: 90%;
        height: 320px;
        background: white;
        border-radius: 50%;
        z-index: 2;
        animation: softZoom 1.6s ease forwards;
    }

    /* === CONTENU === */
    .content {
        position: relative;
        z-index: 3;
        text-align: center;
        padding: 1rem 2rem 5rem;
    }

    .subtitle {
        font-size: 0.9rem;
        letter-spacing: 2px;
        margin-bottom: 5px;
        text-transform: uppercase;
        font-family: 'Alice', serif;
        color: {{ template.secondaryColor }};
        animation: fadeUp 1s ease forwards;
        animation-delay: 0.6s;
        opacity: 0;
    }

    .names {
        font-family: 'Alex Brush', cursive;
        font-size: 3rem;
        line-height: 1.1;
        margin-bottom: 2rem;
        color: {{ template.primaryColor }};
        animation: fadeUp 1s ease forwards;
        animation-delay: 1s;
        opacity: 0;
    }

    .date {
        font-size: 0.95rem;
        line-height: 1.7;
        font-family: 'Alice', serif;
        color: {{ template.secondaryColor }};
        animation: fadeUp 1s ease forwards;
        animation-delay: 1.4s;
        opacity: 0;
    }

    .date strong {
        color: {{ template.primaryColor }};
    }

    /* === FLEURS === */
    .flower {
        position: absolute;
        width: 180px;
        z-index: 4;
        opacity: 0;
        pointer-events: none;
    }

    .flower.top.left {
        top: 160px;
        left: 0;
        animation: fadeUp 1.2s ease forwards 0.8s, parallaxFloat1 8s ease-in-out infinite;
    }

    .flower.top.right {
        top: 160px;
        right: 0;
        animation: fadeUp 1.2s ease forwards 1s, parallaxFloat2 10s ease-in-out infinite;
    }

    .flower.bottom.left {
        bottom: 0;
        left: 0;
        animation: fadeUp 1.2s ease forwards 1.2s, parallaxFloat3 7s ease-in-out infinite;
    }

    .flower.bottom.right {
        bottom: 0;
        right: 0;
        animation: fadeUp 1.2s ease forwards 1.4s, parallaxFloat4 9s ease-in-out infinite;
    }

    /* ======================
       ANIMATIONS
    ====================== */
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes softZoom {
        from {
            transform: translateX(-50%) scale(0.95);
            opacity: 0;
        }
        to {
            transform: translateX(-50%) scale(1);
            opacity: 1;
        }
    }

    /* Effet parallax avec différentes vitesses et directions - sans rotation */
    @keyframes parallaxFloat1 {
        0%, 100% {
            transform: translateY(0) translateX(0);
        }
        25% {
            transform: translateY(-15px) translateX(5px);
        }
        50% {
            transform: translateY(-8px) translateX(-3px);
        }
        75% {
            transform: translateY(-12px) translateX(3px);
        }
    }

    @keyframes parallaxFloat2 {
        0%, 100% {
            transform: translateY(0) translateX(0);
        }
        25% {
            transform: translateY(-12px) translateX(-5px);
        }
        50% {
            transform: translateY(-18px) translateX(3px);
        }
        75% {
            transform: translateY(-10px) translateX(-2px);
        }
    }

    @keyframes parallaxFloat3 {
        0%, 100% {
            transform: translateY(0) translateX(0);
        }
        30% {
            transform: translateY(-10px) translateX(-4px);
        }
        60% {
            transform: translateY(-14px) translateX(4px);
        }
        90% {
            transform: translateY(-6px) translateX(-2px);
        }
    }

    @keyframes parallaxFloat4 {
        0%, 100% {
            transform: translateY(0) translateX(0);
        }
        20% {
            transform: translateY(-16px) translateX(6px);
        }
        40% {
            transform: translateY(-9px) translateX(-4px);
        }
        80% {
            transform: translateY(-13px) translateX(2px);
        }
    }
</style>

<div class="invitation-card">
    <!-- Background top -->
    <div class="bg-top"></div>

    <!-- Cercle blanc (mask) -->
    <div class="white-mask"></div>

    <!-- Fleurs haut -->
    <img src="{{ asset('templates/minimal/folwer.png') }}" class="flower top left" alt="flower decoration">
    <img src="{{ asset('templates/minimal/folwer2.png') }}" class="flower top right" alt="flower decoration">

    <!-- Contenu -->
    <div class="content">
        <div class="subtitle">SAVE THE DATE</div>
        <div class="names">
            {{ invitation is defined ? invitation.event.title : 'Jean & Jeanne' }}
        </div>
        <div class="date">
            {{ date }}<br>
            {{ hour }}:{{ minute }}<br>
            <strong>{{ invitation is defined ? invitation.event.placeName : 'Salle de fête' }}</strong><br>
            {{ invitation is defined ? invitation.event.address : '15, Avenue de la justice. Kinshasa' }}
        </div>
    </div>

    <!-- Fleurs bas -->
    <img src="{{ asset('templates/minimal/folwer2.png') }}" class="flower bottom left" alt="flower decoration">
    <img src="{{ asset('templates/minimal/folwer.png') }}" class="flower bottom right" alt="flower decoration">
</div>

