<style>
    @font-face {
        font-family: 'Fraunces';
        src: url('{{ asset('templates/basic/Fraunces/Fraunces-VariableFont_SOFT,WONK,opsz,wght.ttf') }}') format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    @font-face {
        font-family: 'TheSeasons';
        src: url('{{ asset('templates/basic/TheSeasons/Fontspring-DEMO-theseasons-reg.otf') }}') format('opentype');
        font-weight: normal;
        font-style: normal;
    }

    .wedding-card {
        position: relative;
        max-width: 600px;
        margin: auto;
        background: #fff;
        overflow: hidden;
        font-family: 'Fraunces', serif;
        color: {{ template.primaryColor }};
    }

    /* === IMAGE TOP === */
    .bg-top {
        height: 260px;
        background: url('{{ asset('templates/minimal/bgtop.png') }}') center/cover no-repeat;
    }

    /* === MASQUE BLANC === */
    .white-mask {
        position: absolute;
        top: 200px;
        left: 50%;
        transform: translateX(-50%);
        width: 120%;
        height: 320px;
        background: white;
        border-radius: 50%;
        z-index: 2;
        animation: softZoom 1.6s ease forwards;
    }

    /* === CONTENU === */
    .content {
        position: relative;
        z-index: 3;
        text-align: center;
        padding: 6rem 2rem 5rem;
    }

    .subtitle {
        font-size: 0.9rem;
        letter-spacing: 2px;
        margin-bottom: 2rem;
        text-transform: uppercase;
        animation: fadeUp 1s ease forwards;
        animation-delay: 0.6s;
        opacity: 0;
    }

    .names {
        font-family: 'TheSeasons', cursive;
        font-size: 3rem;
        line-height: 1.1;
        margin-bottom: 2rem;
        animation: fadeUp 1s ease forwards;
        animation-delay: 1s;
        opacity: 0;
    }

    .date {
        font-size: 0.95rem;
        line-height: 1.7;
        animation: fadeUp 1s ease forwards;
        animation-delay: 1.4s;
        opacity: 0;
    }

    /* === FLEURS === */
    .flower {
        position: absolute;
        width: 180px;
        z-index: 4;
        opacity: 0;
        animation: fadeUp 1.2s ease forwards, floatFlower 6s ease-in-out infinite;
    }

    .flower.top.left {
        top: 160px;
        left: -60px;
        animation-delay: 0.8s;
    }

    .flower.top.right {
        top: 160px;
        right: -60px;
        transform: scaleX(-1);
        animation-delay: 1s;
    }

    .flower.bottom.left {
        bottom: -40px;
        left: -60px;
        animation-delay: 1.2s;
    }

    .flower.bottom.right {
        bottom: -40px;
        right: -60px;
        transform: scaleX(-1);
        animation-delay: 1.4s;
    }

    /* ======================
       ANIMATIONS
    ====================== */
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes softZoom {
        from {
            transform: translateX(-50%) scale(0.95);
            opacity: 0;
        }
        to {
            transform: translateX(-50%) scale(1);
            opacity: 1;
        }
    }

    @keyframes floatFlower {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
</style>

<div class="wedding-card">
    <!-- Background top -->
    <div class="bg-top"></div>

    <!-- Cercle blanc (mask) -->
    <div class="white-mask"></div>

    <!-- Fleurs haut -->
    <img src="{{ asset('templates/minimal/folwer.png') }}" class="flower top left" alt="flower decoration">
    <img src="{{ asset('templates/minimal/folwer.png') }}" class="flower top right" alt="flower decoration">

    <!-- Contenu -->
    <div class="content">
        <div class="subtitle">SAVE THE DATE</div>
        <div class="names">
            {{ invitation.event.title }}
        </div>
        <div class="date">
            {{ date }}<br>
            {{ hour }}:{{ minute }}<br><br>
            <strong>{{ invitation.event.placeName }}</strong><br>
            {{ invitation.event.address }}
        </div>
    </div>

    <!-- Fleurs bas -->
    <img src="{{ asset('templates/minimal/folwer.png') }}" class="flower bottom left" alt="flower decoration">
    <img src="{{ asset('templates/minimal/folwer.png') }}" class="flower bottom right" alt="flower decoration">
</div>

