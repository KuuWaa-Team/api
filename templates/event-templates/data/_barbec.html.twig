<style>
    /* === POLICES === */
    @font-face {
        font-family: 'CyGrotesk-GrandBlack';
        src: url('{{ asset('templates/barbec/CyGrotesk/CyGrotesk-GrandBlack.otf') }}') format('opentype');
    }

    @font-face {
        font-family: 'CyGrotesk-Regular';
        src: url('{{ asset('templates/barbec/CyGrotesk/CyGrotesk-GrandRegular.otf') }}') format('opentype');
    }

    @font-face {
        font-family: 'BrittanySignature';
        src: url('{{ asset('templates/barbec/BrittanySignature.ttf') }}') format('truetype');
    }

    /* === GLOBAL === */
    body {
        margin: 0;
        padding: 0;
        background-color: #f6f8ff;
        font-family: 'CyGrotesk-Regular', sans-serif;
        color: {{ template.primaryColor }};
    }

    .invitation-card {
        position: relative;
        background-color: #ffffff;
        max-width: 600px;
        margin: 4rem auto;
        text-align: left;
        padding: 3rem 2rem;
        overflow: hidden;
        color: {{ template.primaryColor }};
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        z-index: 2;
    }

    /* === TITRE PRINCIPAL === */
    .main-title {
        font-family: 'CyGrotesk-GrandBlack', sans-serif;
        font-size: 3rem;
        line-height: 0.9;
        text-transform: uppercase;
        margin-bottom: 2.5rem;
        color: {{ template.primaryColor }};
        text-align: left;
        animation: popIn 1.2s ease;
    }

    @keyframes popIn {
        0% { transform: scale(0.8); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }

    /* === BLOC PRINCIPAL: TEXTE + ICÔNE === */
    .party-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: no-wrap;
    }

    .text-block {
        flex: 1;
        min-width: 220px;
    }

    .script-text {
        font-family: 'BrittanySignature', cursive;
        max-width: 70%;
        font-size: 2rem;
        margin-bottom: 0.8rem;
        animation: float 4s ease-in-out infinite;
    }

    .text-line {
        font-family: 'CyGrotesk-Regular', sans-serif;
        font-size: .8rem;
        line-height: 1.5;
        max-width: 75%;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    /* === ICÔNE DU VERRE === */
    .glass {
        width: 160px;
        margin-right: 15px;
        height: auto;
        animation: shake 6s ease-in-out infinite;
    }

    @keyframes shake {
        0%, 100% { transform: rotate(-5deg); }
        50% { transform: rotate(5deg); }
    }

    /* === NOM DE L'ÉVÉNEMENT === */
    .names {
        font-family: 'CyGrotesk-GrandBlack', sans-serif;
        font-size: 1.4rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-top: 2rem;
        text-align: center;
    }

    /* === DÉTAILS === */
    .details {
        font-weight: bolder;
        margin-top: 40px;
        color: black;
        font-family: 'CyGrotesk-Regular', sans-serif;
        font-size: 0.95rem;
        line-height: 1.6;
        text-align: center;
    }

    /* === ÉTOILES === */
    .star {
        position: absolute;
        width: 40px;
        animation: twinkle 3s ease-in-out infinite;
        z-index: 1;
    }

    .star.small { width: 25px; }
    .star.left { top: 10%; left: 10%; animation-delay: 1s; }
    .star.right { top: 15%; right: 15%; animation-delay: 2s; }
    .star.bottom { bottom: 10%; right: 25%; animation-delay: 3s; }

    @keyframes twinkle {
        0%, 100% { opacity: 0.3; transform: scale(0.9); }
        50% { opacity: 1; transform: scale(1.2); }
    }
</style>

<div class="invitation-card">
    <!-- ÉTOILES DÉCORATIVES -->
    <img src="{{ asset('templates/barbec/star.png') }}" class="star left" alt="star">
    <img src="{{ asset('templates/barbec/star.png') }}" class="star right small" alt="star">
    <img src="{{ asset('templates/barbec/star.png') }}" class="star bottom" alt="star">

    <!-- TITRE -->
    <div class="main-title">LET’S<br>PARTY!</div>

    <!-- CONTENU PRINCIPAL -->
    <div class="party-row">
        <img src="{{ asset('templates/barbec/glass.png') }}" class="glass" alt="Glass">
        <div class="text-block">
            <div class="script-text">Join us to celebrate</div>
            <div class="text-line">
                A night full of laughter, music & good vibes.<br>
                Saturday, {{ date }} at {{ hour }}h{{ minute }}
            </div>
        </div>
    </div>

    <!-- INFORMATIONS ÉVÉNEMENT -->
    {# <div class="names">{{ invitation.event.title|upper }}</div> #}

    <div class="details">
        {{ invitation.event.address }}, {{ invitation.event.placeName }}<br>
        RSVP to Juli +123-456-7890
    </div>
</div>
